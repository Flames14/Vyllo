storeFile=.signing/vyllo-release.keystore
storePassword=your-store-password
keyAlias=vyllo-release
keyPassword=your-key-password
# Optional: YouTube BotGuard / Innertube API key (also: VYLLO_GOOGLE_API_KEY env var)
googleApiKey=your-google-api-key
# Optional: override the committed api.github.com cert pins (also: VYLLO_CERT_PINS env var).
# Format: host=sha256/<base64>,host=sha256/<base64>
# certPins=api.github.com=sha256/REPLACE_WITH_REAL_PIN
